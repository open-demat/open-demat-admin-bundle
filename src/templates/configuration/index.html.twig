{% extends 'base.html.twig' %}

{% block title %}Configuration globale{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
      .admin-config {
        max-width: 1200px;
      }
      .admin-config-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1rem;
      }
      .admin-config-form {
        display: grid;
        gap: 1rem;
        margin-bottom: 1.5rem;
      }
      .admin-config-fieldset,
      .admin-config-card {
        border: 1px solid var(--border, #dee2e6);
        border-radius: .5rem;
        background: #fff;
      }
      .admin-config-fieldset {
        padding: 1rem;
      }
      .admin-config-fieldset legend {
        float: none;
        width: auto;
        padding: 0 .35rem;
        margin-bottom: .75rem;
        font-size: 1rem;
        font-weight: 600;
      }
      .admin-config-fields {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: .85rem;
      }
      .admin-config-card {
        overflow: hidden;
      }
      .admin-config-card h2 {
        font-size: 1rem;
        margin: 0;
        padding: .9rem 1rem;
        border-bottom: 1px solid var(--border, #dee2e6);
        background: #f8f9fa;
      }
      .admin-config-row {
        display: grid;
        grid-template-columns: minmax(110px, 36%) minmax(0, 1fr);
        gap: .75rem;
        padding: .75rem 1rem;
        border-bottom: 1px solid #f1f3f5;
      }
      .admin-config-row:last-child {
        border-bottom: 0;
      }
      .admin-config-label {
        color: #6c757d;
        font-size: .86rem;
      }
      .admin-config-value {
        min-width: 0;
        font-family: var(--bs-font-monospace);
        font-size: .86rem;
        word-break: break-word;
      }
      .admin-config-empty {
        color: #adb5bd;
        font-family: var(--bs-body-font-family);
      }
      @media (max-width: 575.98px) {
        .admin-config-row {
          grid-template-columns: 1fr;
          gap: .25rem;
        }
      }
    </style>
{% endblock %}

{% block body %}
<div class="container-fluid admin-config">
    <div class="d-flex align-items-start justify-content-between gap-3 mb-4 flex-wrap">
        <div>
            <h1 class="page-title mb-1">Configuration globale</h1>
            <p class="small text-muted mb-0">Parametres Organisation, theme, CAS, SAML2 et S3 charges depuis Symfony et les variables d'environnement.</p>
        </div>
        <a href="{{ path('open_demat_admin_dashboard') }}" class="btn btn-outline-secondary btn-sm">
            <i class="bx bx-arrow-back" aria-hidden="true"></i>
            Retour
        </a>
    </div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'danger' ? 'danger' : label }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <form method="post" action="{{ path('open_demat_admin_configuration_update') }}" class="admin-config-form" enctype="multipart/form-data">
        <input type="hidden" name="_token" value="{{ csrf_token('open_demat_admin_configuration') }}">

        <fieldset class="admin-config-fieldset">
            <legend>Organisation</legend>
            <div class="admin-config-fields">
                <div>
                    <label class="form-label" for="organization_name">Nom</label>
                    <input class="form-control" id="organization_name" name="organization[name]" value="{{ formValues.organization.name }}">
                </div>
                <div>
                    <label class="form-label" for="organization_logo">Logo</label>
                    <input class="form-control" id="organization_logo" name="organization_logo" type="file" accept="image/png,image/jpeg,image/svg+xml,image/webp">
                    {% if formValues.organization.logo %}
                        <div class="form-text">
                            Logo actuel : <a href="{{ asset(formValues.organization.logo) }}" target="_blank" rel="noopener">ouvrir</a>
                        </div>
                    {% endif %}
                    <button type="submit" class="btn btn-outline-danger btn-sm mt-2" name="delete_logo" value="1" formnovalidate>
                        <i class="bx bx-trash" aria-hidden="true"></i>
                        Revenir au logo par defaut
                    </button>
                </div>
            </div>
        </fieldset>

        <fieldset class="admin-config-fieldset">
            <legend>Theme</legend>
            <div class="admin-config-fields">
                <div>
                    <label class="form-label" for="theme_primary_color">Couleur principale</label>
                    <input class="form-control form-control-color" id="theme_primary_color" name="theme[primary_color]" type="color" value="{{ formValues.theme.primary_color|default('#E30613') }}">
                </div>
                <div>
                    <label class="form-label" for="theme_primary_dark_color">Couleur principale foncee</label>
                    <input class="form-control form-control-color" id="theme_primary_dark_color" name="theme[primary_dark_color]" type="color" value="{{ formValues.theme.primary_dark_color|default('#15202B') }}">
                </div>
            </div>
            <button type="submit" class="btn btn-outline-secondary btn-sm mt-3" name="reset_theme" value="1" formnovalidate>
                <i class="bx bx-reset" aria-hidden="true"></i>
                Revenir au theme par defaut
            </button>
        </fieldset>

        <fieldset class="admin-config-fieldset">
            <legend>CAS</legend>
            <div class="admin-config-fields">
                <div>
                    <label class="form-label" for="cas_base_url">URL de base</label>
                    <input class="form-control" id="cas_base_url" name="cas[base_url]" value="{{ formValues.cas.base_url }}">
                </div>
                <div>
                    <label class="form-label" for="cas_logout_url">URL de deconnexion</label>
                    <input class="form-control" id="cas_logout_url" name="cas[logout_url]" value="{{ formValues.cas.logout_url }}">
                </div>
                <div>
                    <label class="form-label" for="cas_host">Hote</label>
                    <input class="form-control" id="cas_host" name="cas[host]" value="{{ formValues.cas.host }}">
                </div>
                <div>
                    <label class="form-label" for="cas_port">Port</label>
                    <input class="form-control" id="cas_port" name="cas[port]" inputmode="numeric" value="{{ formValues.cas.port }}">
                </div>
                <div>
                    <label class="form-label" for="cas_path">Chemin</label>
                    <input class="form-control" id="cas_path" name="cas[path]" value="{{ formValues.cas.path }}">
                </div>
                <div>
                    <label class="form-label" for="cas_login_target">Cible de connexion</label>
                    <input class="form-control" id="cas_login_target" name="cas[login_target]" value="{{ formValues.cas.login_target }}">
                </div>
                <div>
                    <label class="form-label" for="cas_gateway">Gateway</label>
                    <select class="form-select" id="cas_gateway" name="cas[gateway]">
                        <option value="0" {{ formValues.cas.gateway == '0' ? 'selected' : '' }}>Non</option>
                        <option value="1" {{ formValues.cas.gateway == '1' ? 'selected' : '' }}>Oui</option>
                    </select>
                </div>
            </div>
        </fieldset>

        <fieldset class="admin-config-fieldset">
            <legend>SAML2</legend>
            <div class="admin-config-fields">
                <div>
                    <label class="form-label" for="saml2_enabled">Actif</label>
                    <select class="form-select" id="saml2_enabled" name="saml2[enabled]">
                        <option value="0" {{ formValues.saml2.enabled == '0' ? 'selected' : '' }}>Non</option>
                        <option value="1" {{ formValues.saml2.enabled == '1' ? 'selected' : '' }}>Oui</option>
                    </select>
                </div>
                <div>
                    <label class="form-label" for="saml2_identifier_attribute">Attribut identifiant</label>
                    <input class="form-control" id="saml2_identifier_attribute" name="saml2[identifier_attribute]" value="{{ formValues.saml2.identifier_attribute }}">
                </div>
                <div>
                    <label class="form-label" for="saml2_email_attribute">Attribut email</label>
                    <input class="form-control" id="saml2_email_attribute" name="saml2[email_attribute]" value="{{ formValues.saml2.email_attribute }}">
                </div>
                <div>
                    <label class="form-label" for="saml2_first_name_attribute">Attribut prenom</label>
                    <input class="form-control" id="saml2_first_name_attribute" name="saml2[first_name_attribute]" value="{{ formValues.saml2.first_name_attribute }}">
                </div>
                <div>
                    <label class="form-label" for="saml2_last_name_attribute">Attribut nom</label>
                    <input class="form-control" id="saml2_last_name_attribute" name="saml2[last_name_attribute]" value="{{ formValues.saml2.last_name_attribute }}">
                </div>
                <div>
                    <label class="form-label" for="saml2_default_email_domain">Domaine email par defaut</label>
                    <input class="form-control" id="saml2_default_email_domain" name="saml2[default_email_domain]" value="{{ formValues.saml2.default_email_domain }}">
                </div>
                <div>
                    <label class="form-label" for="saml2_auto_create_user">Creation utilisateur auto</label>
                    <select class="form-select" id="saml2_auto_create_user" name="saml2[auto_create_user]">
                        <option value="0" {{ formValues.saml2.auto_create_user == '0' ? 'selected' : '' }}>Non</option>
                        <option value="1" {{ formValues.saml2.auto_create_user == '1' ? 'selected' : '' }}>Oui</option>
                    </select>
                </div>
                <div>
                    <label class="form-label" for="saml2_login_url">URL de connexion</label>
                    <input class="form-control" id="saml2_login_url" name="saml2[login_url]" value="{{ formValues.saml2.login_url }}">
                </div>
            </div>
        </fieldset>

        <fieldset class="admin-config-fieldset">
            <legend>S3</legend>
            <div class="admin-config-fields">
                <div>
                    <label class="form-label" for="s3_endpoint">Endpoint</label>
                    <input class="form-control" id="s3_endpoint" name="s3[endpoint]" value="{{ formValues.s3.endpoint }}">
                </div>
                <div>
                    <label class="form-label" for="s3_region">Region</label>
                    <input class="form-control" id="s3_region" name="s3[region]" value="{{ formValues.s3.region }}">
                </div>
                <div>
                    <label class="form-label" for="s3_bucket">Bucket</label>
                    <input class="form-control" id="s3_bucket" name="s3[bucket]" value="{{ formValues.s3.bucket }}">
                </div>
                <div>
                    <label class="form-label" for="s3_use_path_style">Path style</label>
                    <select class="form-select" id="s3_use_path_style" name="s3[use_path_style]">
                        <option value="0" {{ formValues.s3.use_path_style == '0' ? 'selected' : '' }}>Non</option>
                        <option value="1" {{ formValues.s3.use_path_style == '1' ? 'selected' : '' }}>Oui</option>
                    </select>
                </div>
                <div>
                    <label class="form-label" for="s3_access_key">Access key</label>
                    <input class="form-control" id="s3_access_key" name="s3[access_key]" type="password" autocomplete="new-password" placeholder="Laisser vide pour conserver">
                </div>
                <div>
                    <label class="form-label" for="s3_secret_key">Secret key</label>
                    <input class="form-control" id="s3_secret_key" name="s3[secret_key]" type="password" autocomplete="new-password" placeholder="Laisser vide pour conserver">
                </div>
            </div>
        </fieldset>

        <div>
            <button type="submit" class="btn btn-primary">
                <i class="bx bx-save" aria-hidden="true"></i>
                Enregistrer
            </button>
        </div>
    </form>

    <div class="admin-config-grid">
        {% for title, rows in sections %}
            <section class="admin-config-card" aria-labelledby="config-section-{{ loop.index }}">
                <h2 id="config-section-{{ loop.index }}">{{ title }}</h2>
                <div>
                    {% for row in rows %}
                        <div class="admin-config-row">
                            <div class="admin-config-label">{{ row.label }}</div>
                            <div class="admin-config-value">
                                {% if row.value is same as('') or row.value is null %}
                                    <span class="admin-config-empty">Non renseigne</span>
                                {% else %}
                                    {{ row.value }}
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </section>
        {% endfor %}
    </div>
</div>
{% endblock %}
