                    </select>
                </div>
                <div>
                    <label class="form-label" for="saml2_sp_entity_id">SP entity ID</label>
                    <input class="form-control" id="saml2_sp_entity_id" name="saml2[sp_entity_id]" value="{{ formValues.saml2.sp_entity_id }}">
