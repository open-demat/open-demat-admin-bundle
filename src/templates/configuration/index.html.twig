                    <select class="form-select" id="ldap_auto_create_user" name="ldap[auto_create_user]">
                        <option value="0" {{ formValues.ldap.auto_create_user == '0' ? 'selected' : '' }}>Non</option>
                        <option value="1" {{ formValues.ldap.auto_create_user == '1' ? 'selected' : '' }}>Oui</option>
                    </select>
                </div>
            </div>
