                </div>
                <div>
                    <label class="form-label" for="ldap_email_attribute">Attribut email</label>
                    <input class="form-control" id="ldap_email_attribute" name="ldap[email_attribute]" value="{{ formValues.ldap.email_attribute }}">
                </div>
                <div>
                    <label class="form-label" for="ldap_first_name_attribute">Attribut prenom</label>
