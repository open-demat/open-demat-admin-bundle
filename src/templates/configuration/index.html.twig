{% extends 'base.html.twig' %}

{% block title %}Configuration globale{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
      .admin-config {
        max-width: 1200px;
      }
      .admin-config-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1rem;
      }
      .admin-config-form {
        display: grid;
        gap: 1rem;
        margin-bottom: 1.5rem;
      }
      .admin-config-fieldset,
      .admin-config-card {
        border: 1px solid var(--border, #dee2e6);
        border-radius: .5rem;
        background: #fff;
      }
      .admin-config-fieldset {
        padding: 1rem;
      }
      .admin-config-fieldset legend {
        float: none;
        width: auto;
        padding: 0 .35rem;
        margin-bottom: .75rem;
        font-size: 1rem;
        font-weight: 600;
      }
      .admin-config-fields {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: .85rem;
      }
      .admin-config-card {
        overflow: hidden;
      }
      .admin-config-card h2 {
        font-size: 1rem;
        margin: 0;
        padding: .9rem 1rem;
        border-bottom: 1px solid var(--border, #dee2e6);
        background: #f8f9fa;
      }
      .admin-config-row {
        display: grid;
        grid-template-columns: minmax(110px, 36%) minmax(0, 1fr);
        gap: .75rem;
        padding: .75rem 1rem;
        border-bottom: 1px solid #f1f3f5;
      }
      .admin-config-row:last-child {
        border-bottom: 0;
      }
      .admin-config-label {
        color: #6c757d;
        font-size: .86rem;
      }
      .admin-config-value {
        min-width: 0;
        font-family: var(--bs-font-monospace);
        font-size: .86rem;
        word-break: break-word;
      }
      .admin-config-empty {
        color: #adb5bd;
        font-family: var(--bs-body-font-family);
      }
      @media (max-width: 575.98px) {
        .admin-config-row {
          grid-template-columns: 1fr;
          gap: .25rem;
        }
      }
    </style>
{% endblock %}

{% block body %}
<div class="container-fluid admin-config">
    <div class="d-flex align-items-start justify-content-between gap-3 mb-4 flex-wrap">
        <div>
            <h1 class="page-title mb-1">Configuration globale</h1>
            <p class="small text-muted mb-0">Parametres Organisation, theme, authentification, SAML2 et S3 charges depuis Symfony et les variables d'environnement.</p>
        </div>
        <a href="{{ path('open_demat_admin_dashboard') }}" class="btn btn-outline-secondary btn-sm">
            <i class="bx bx-arrow-back" aria-hidden="true"></i>
            Retour
        </a>
    </div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'danger' ? 'danger' : label }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <form method="post" action="{{ path('open_demat_admin_configuration_update') }}" class="admin-config-form" enctype="multipart/form-data">
        <input type="hidden" name="_token" value="{{ csrf_token('open_demat_admin_configuration') }}">

        <fieldset class="admin-config-fieldset">
            <legend>Organisation</legend>
            <div class="admin-config-fields">
                <div>
                    <label class="form-label" for="organization_name">Nom</label>
                    <input class="form-control" id="organization_name" name="organization[name]" value="{{ formValues.organization.name }}">
                </div>
                <div>
                    <label class="form-label" for="organization_logo">Logo</label>
                    <input class="form-control" id="organization_logo" name="organization_logo" type="file" accept="image/png,image/jpeg,image/svg+xml,image/webp">
                    {% if formValues.organization.logo %}
                        <div class="form-text">
                            Logo actuel : <a href="{{ asset(formValues.organization.logo) }}" target="_blank" rel="noopener">ouvrir</a>
                        </div>
                    {% endif %}
                    <button type="submit" class="btn btn-outline-danger btn-sm mt-2" name="delete_logo" value="1" formnovalidate>
                        <i class="bx bx-trash" aria-hidden="true"></i>
                        Revenir au logo par defaut
                    </button>
                </div>
            </div>
        </fieldset>

        <fieldset class="admin-config-fieldset">
            <legend>Theme</legend>
            <div class="admin-config-fields">
                <div>
                    <label class="form-label" for="theme_primary_color">Couleur principale</label>
                    <input class="form-control form-control-color" id="theme_primary_color" name="theme[primary_color]" type="color" value="{{ formValues.theme.primary_color|default('#E30613') }}">
                </div>
                <div>
                    <label class="form-label" for="theme_primary_dark_color">Couleur principale foncee</label>
                    <input class="form-control form-control-color" id="theme_primary_dark_color" name="theme[primary_dark_color]" type="color" value="{{ formValues.theme.primary_dark_color|default('#15202B') }}">
                </div>
            </div>
            <button type="submit" class="btn btn-outline-secondary btn-sm mt-3" name="reset_theme" value="1" formnovalidate>
                <i class="bx bx-reset" aria-hidden="true"></i>
                Revenir au theme par defaut
            </button>
        </fieldset>

        <fieldset class="admin-config-fieldset">
            <legend>Authentification locale</legend>
            <div class="admin-config-fields">
                <div>
                    <label class="form-label" for="local_admin_username">Login administrateur</label>
                    <input class="form-control" id="local_admin_username" name="local[admin_username]" value="{{ formValues.local.admin_username }}">
                </div>
                <div>
                    <label class="form-label" for="local_admin_password">Mot de passe administrateur</label>
                    <input class="form-control" id="local_admin_password" name="local[admin_password]" type="password" autocomplete="new-password" placeholder="Laisser vide pour conserver">
                </div>
            </div>
        </fieldset>

        <fieldset class="admin-config-fieldset">
            <legend>CAS</legend>
            <div class="admin-config-fields">
